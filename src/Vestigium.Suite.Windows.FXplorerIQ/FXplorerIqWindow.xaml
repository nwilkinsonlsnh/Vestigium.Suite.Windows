<Window x:Class="Vestigium.Suite.Windows.FXplorerIQ.FXplorerIqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Vestigium.Controls.Shell;assembly=Vestigium.Controls"
        Title="FXplorerIQ"
        Height="980" Width="1800"
        MinHeight="640" MinWidth="1200"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="12,8,12,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <StackPanel x:Name="ExplorerTabs" Orientation="Horizontal" />
        <Button x:Name="AddExplorer"
                Content="+"
                Style="{StaticResource Button.Utility}"
                Width="32"
                Height="32"
                MinWidth="32"
                MinHeight="32"
                Padding="0"
                FontSize="16"
                ToolTip="New Explorer"
                VerticalAlignment="Center"
                Margin="4,0,0,0"
                Click="AddExplorer_Click" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <RadioButton Content="Dashboard"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="FXplorerMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Settings"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="FXplorerMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Help"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="FXplorerMainNav"
                     Margin="0"
                     Checked="MainNav_Checked" />
      </StackPanel>
    </Grid>
    <shell:VestigiumShell x:Name="RootShell"
                          ShowNav="False"
                          Status="{Binding Status}"
                          StatusBarPosition="{Binding Status.Position, Mode=TwoWay}"
                          ShowStatusBar="{Binding ShowStatusBar}" />
  </DockPanel>
</Window>
