<UserControl x:Class="Vestigium.Suite.Windows.FXplorerIQ.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid x:Name="Root" Margin="12,8,12,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="160" />
      <ColumnDefinition x:Name="SplitColumn" Width="8" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" x:Name="TreeHost" Margin="0,0,0,0" LastChildFill="True">
      <Grid DockPanel.Dock="Top" Height="48" Margin="0,0,0,8">
        <TextBlock Text="Folders"
                   Style="{StaticResource TextBlock.Caption}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Button x:Name="TreeToggle"
                Style="{StaticResource Button.Utility}"
                Content="◄"
                ToolTip="Hide folders"
                Width="32"
                Height="32"
                MinWidth="32"
                MinHeight="32"
                Padding="0"
                FontSize="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="TreeToggle_Click" />
      </Grid>
      <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Default}"
              BorderThickness="1"
              CornerRadius="6">
        <TreeView x:Name="Folders"
                  Style="{StaticResource TreeView.Standard}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Pane_PreviewMouseWheel"
                  SelectedItemChanged="Folders_SelectedItemChanged">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Standard}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
    </DockPanel>

    <GridSplitter x:Name="TreeSplit"
                  Grid.Column="1"
                  Width="8"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  ShowsPreview="False"
                  Background="{DynamicResource Vestigium.Brushes.Stroke.Default}"
                  DragCompleted="TreeSplit_DragCompleted" />

    <Grid x:Name="TreeOpenHost" Grid.Column="0" Height="48" VerticalAlignment="Top" Visibility="Collapsed">
      <Button x:Name="TreeOpen"
              Style="{StaticResource Button.Utility}"
              Content="►"
              ToolTip="Show folders"
              Width="32"
              Height="32"
              MinWidth="32"
              MinHeight="32"
              Padding="0"
              FontSize="12"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="TreeToggle_Click" />
    </Grid>

    <DockPanel Grid.Column="2" LastChildFill="True">
      <Grid DockPanel.Dock="Top" Height="48" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="UpButton"
                Content="Up"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                MinHeight="36"
                Padding="16,6"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Click="Up_Click" />
        <TextBox x:Name="PathBox"
                 Grid.Column="1"
                 Style="{StaticResource TextBox.Standard}"
                 MinHeight="36"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 KeyDown="PathBox_KeyDown" />
        <Button Content="Go"
                Grid.Column="2"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                MinHeight="36"
                Padding="16,6"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                Click="Go_Click" />
      </Grid>
      <Grid>
        <DataGrid x:Name="Listing"
                  Style="{StaticResource DataGrid.Standard}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserResizeColumns="True"
                  HorizontalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Pane_PreviewMouseWheel"
                  MouseDoubleClick="Listing_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" MinWidth="40" />
            <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified}" Width="160" MinWidth="40" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" MinWidth="40" />
            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="72" MinWidth="40" />
            <DataGridTextColumn Header="File Hash" Binding="{Binding Hash}" Width="280" MinWidth="40" />
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" MinWidth="40" />
            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" MinWidth="40" />
          </DataGrid.Columns>
        </DataGrid>
        <Border x:Name="BusyOverlay"
                Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
                Opacity="0.92"
                Visibility="Collapsed"
                IsHitTestVisible="True">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock x:Name="BusyMessage"
                       Text="Loading"
                       Style="{StaticResource TextBlock.Standard}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                         IsIndeterminate="True"
                         Width="240"
                         Height="6"
                         HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
