<UserControl x:Class="Vestigium.Suite.Windows.FXplorerIQ.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Top">
  <Grid x:Name="Root" Margin="12,8,12,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="TreeColumn" Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" x:Name="TreeHost" Margin="0,0,8,0" LastChildFill="True">
      <Grid DockPanel.Dock="Top" Height="32" Margin="0,0,0,4">
        <TextBlock Text="Folders"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Button x:Name="TreeToggle"
                Style="{StaticResource Button.Utility}"
                Content="◀"
                ToolTip="Hide folders"
                Width="28"
                Height="28"
                MinWidth="28"
                MinHeight="28"
                Padding="0"
                FontSize="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="TreeToggle_Click" />
      </Grid>
      <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Default}"
              BorderThickness="1"
              CornerRadius="6">
        <TreeView x:Name="Folders"
                  Style="{StaticResource TreeView.Standard}"
                  ItemContainerStyle="{StaticResource TreeViewItem.Standard}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Pane_PreviewMouseWheel"
                  SelectedItemChanged="Folders_SelectedItemChanged">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
    </DockPanel>

    <Button x:Name="TreeOpen"
            Grid.Column="0"
            Style="{StaticResource Button.Utility}"
            Content="▶"
            ToolTip="Show folders"
            Width="28"
            Height="28"
            MinWidth="28"
            MinHeight="28"
            Padding="0"
            FontSize="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Click="TreeToggle_Click" />

    <DockPanel Grid.Column="1" LastChildFill="True">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="UpButton"
                Content="Up"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                Margin="0,0,8,0"
                Click="Up_Click" />
        <TextBox x:Name="PathBox"
                 Grid.Column="1"
                 Style="{StaticResource TextBox.Standard}"
                 KeyDown="PathBox_KeyDown" />
        <Button Content="Go"
                Grid.Column="2"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                Margin="8,0,0,0"
                Click="Go_Click" />
      </Grid>
      <DataGrid x:Name="Listing"
                Style="{StaticResource DataGrid.Standard}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                PreviewMouseWheel="Pane_PreviewMouseWheel"
                MouseDoubleClick="Listing_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.4*" MinWidth="180" />
          <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified}" Width="160" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="72" />
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
          <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
