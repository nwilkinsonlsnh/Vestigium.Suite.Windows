<UserControl x:Class="Vestigium.Suite.Windows.FXplorerIQ.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid x:Name="Root" Margin="12,8,12,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="160" />
      <ColumnDefinition x:Name="SplitColumn" Width="8" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Default}"
            BorderThickness="1"
            CornerRadius="6">
      <TreeView x:Name="Folders"
                  Style="{StaticResource TreeView.Standard}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Pane_PreviewMouseWheel"
                  PreviewMouseRightButtonDown="Folders_RightClick"
                  SelectedItemChanged="Folders_SelectedItemChanged">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Standard}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{Binding Icon}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
    </Border>

    <GridSplitter x:Name="TreeSplit"
                  Grid.Column="1"
                  Width="8"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  ShowsPreview="False"
                  Background="{DynamicResource Vestigium.Brushes.Stroke.Default}"
                  DragCompleted="TreeSplit_DragCompleted" />

    <DockPanel Grid.Column="2" LastChildFill="True">
      <Grid DockPanel.Dock="Top" Height="48" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="UpButton"
                Content="Up"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                MinHeight="36"
                Padding="16,6"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Click="Up_Click" />
        <TextBox x:Name="PathBox"
                 Grid.Column="1"
                 Style="{StaticResource TextBox.Standard}"
                 MinHeight="36"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 KeyDown="PathBox_KeyDown" />
        <Button Content="Go"
                Grid.Column="2"
                Style="{StaticResource Button.Primary}"
                MinWidth="72"
                MinHeight="36"
                Padding="16,6"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                Click="Go_Click" />
      </Grid>
      <Grid>
        <DataGrid x:Name="Listing"
                  Style="{StaticResource DataGrid.Standard}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserResizeColumns="True"
                  HorizontalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Pane_PreviewMouseWheel"
                  PreviewMouseRightButtonDown="Listing_RightClick"
                  MouseDoubleClick="Listing_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Icon" Width="36" MinWidth="36">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Image Width="16" Height="16" HorizontalAlignment="Center" Source="{Binding Icon}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" MinWidth="40" />
            <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified}" Width="160" MinWidth="40" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" MinWidth="40" />
            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="72" MinWidth="40" />
            <DataGridTextColumn Header="File Hash" Binding="{Binding Hash}" Width="280" MinWidth="40" />
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" MinWidth="40" />
            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" MinWidth="40" />
          </DataGrid.Columns>
        </DataGrid>
        <Border x:Name="BusyOverlay"
                Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
                Opacity="0.92"
                Visibility="Collapsed"
                IsHitTestVisible="True">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock x:Name="BusyMessage"
                       Text="Loading"
                       Style="{StaticResource TextBlock.Standard}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <ProgressBar Style="{StaticResource ProgressBar.Thin}"
                         IsIndeterminate="True"
                         Width="240"
                         Height="6"
                         HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
