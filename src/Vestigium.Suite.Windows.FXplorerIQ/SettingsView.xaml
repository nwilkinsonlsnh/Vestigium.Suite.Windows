<UserControl x:Class="Vestigium.Suite.Windows.FXplorerIQ.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="Themes"
                   GroupName="FXplorerSettings"
                   IsChecked="True" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="420" Margin="8,0,0,0">
      <TextBlock Style="{StaticResource TextBlock.Caption}"
                 Margin="0,0,0,16"
                 TextWrapping="Wrap"
                 Text="Palette for the application." />
      <Label Style="{StaticResource Label.Standard}" Content="Theme" />
      <ComboBox x:Name="ThemeBox"
                Style="{StaticResource ComboBox.Standard}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                IsEditable="False"
                IsReadOnly="True"
                Width="220"
                HorizontalAlignment="Left"
                SelectionChanged="ThemeBox_SelectionChanged" />
    </StackPanel>
  </DockPanel>
</UserControl>
