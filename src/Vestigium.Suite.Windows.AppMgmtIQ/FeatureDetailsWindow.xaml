<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.FeatureDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Caption}"
        Height="420" Width="640"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="140" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Style="{StaticResource TextBlock.Caption}" Text="Display name" />
    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Caption}" />
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,0,8" Style="{StaticResource TextBlock.Caption}" Text="Feature name" />
    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Name}" />
    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,8" Style="{StaticResource TextBlock.Caption}" Text="State" />
    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding State}" />
    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,0,8" Style="{StaticResource TextBlock.Caption}" Text="Status" />
    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Status}" />
    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextBlock.Caption}" Text="Description" />
    <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Description}" />
  </Grid>
</Window>
