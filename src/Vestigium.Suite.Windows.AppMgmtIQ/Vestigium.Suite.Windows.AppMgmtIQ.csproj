<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vestigium.Suite.Windows.AppMgmtIQ</RootNamespace>
    <AssemblyName>AppMgmtIQ</AssemblyName>
    <ApplicationTitle>AppMgmtIQ</ApplicationTitle>
    <ApplicationIcon>Assets\AppMgmtIQ.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppMgmtIQ.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDiVersion)" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Vestigium.Logging" Version="$(VestigiumLoggingVersion)" />
    <PackageReference Include="Vestigium.Themes" Version="$(VestigiumThemesVersion)" />
    <PackageReference Include="Vestigium.Controls" Version="$(VestigiumControlsVersion)" />
    <PackageReference Include="Vestigium.Controls.QueryBar" Version="$(VestigiumQueryBarVersion)" />
    <PackageReference Include="Vestigium.Controls.StatusBar" Version="$(VestigiumStatusBarVersion)" />
    <PackageReference Include="Vestigium.Controls.NumericUpDown" Version="$(VestigiumNumericUpDownVersion)" />
    <PackageReference Include="Vestigium.Controls.UnderConstruction" Version="$(VestigiumUnderConstructionVersion)" />
    <PackageReference Include="Vestigium.Converters" Version="$(VestigiumConvertersVersion)" />
    <PackageReference Include="Vestigium.Helpers.Analytics" Version="$(VestigiumAnalyticsVersion)" />
    <PackageReference Include="Vestigium.Helpers.Charts" Version="$(VestigiumChartsVersion)" />
    <PackageReference Include="Vestigium.Helpers.ClosedXml" Version="$(VestigiumClosedXmlVersion)" />
    <PackageReference Include="Vestigium.Helpers.Kql" Version="$(VestigiumKqlVersion)" />
    <PackageReference Include="Vestigium.Helpers.Kql.AppMgmt" Version="$(VestigiumKqlAppMgmtVersion)" />
    <PackageReference Include="Vestigium.Helpers.Kql.ActiveSetup" Version="$(VestigiumKqlActiveSetupVersion)" />
    <PackageReference Include="Vestigium.Helpers.WinReg" Version="$(VestigiumWinRegVersion)" />
    <PackageReference Include="Vestigium.Helpers.FileSystemPaths" Version="$(VestigiumFileSystemPathsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Suite.Windows.AppMgmtIQ.Features\Vestigium.Suite.Windows.AppMgmtIQ.Features.csproj" />
    <ProjectReference Include="..\Vestigium.Suite.Windows.AppMgmtIQ.ActiveSetup\Vestigium.Suite.Windows.AppMgmtIQ.ActiveSetup.csproj" />
    <ProjectReference Include="..\Vestigium.Suite.Windows.AppMgmtIQ.Bloatware\Vestigium.Suite.Windows.AppMgmtIQ.Bloatware.csproj" />
    <ProjectReference Include="..\Vestigium.Suite.Windows.AppMgmtIQ.Startup\Vestigium.Suite.Windows.AppMgmtIQ.Startup.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyStartupExe" AfterTargets="Build">
    <PropertyGroup>
      <StartupExe>$(MSBuildProjectDirectory)\..\Vestigium.Suite.Windows.AppMgmtIQ.Startup\bin\$(Configuration)\net10.0-windows\AppMgmtIQ.Startup.exe</StartupExe>
    </PropertyGroup>
    <Copy SourceFiles="$(StartupExe)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(StartupExe)')" />
  </Target>
</Project>
