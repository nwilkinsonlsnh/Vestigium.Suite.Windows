<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.AppMgmtIqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Vestigium.Controls.Shell;assembly=Vestigium.Controls"
        Title="AppMgmtIQ"
        Height="980" Width="1800"
        MinHeight="640" MinWidth="1400"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="12,8,12,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <RadioButton Content="AppMgmtIQ"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     IsChecked="True"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Windows Features"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Bloatware"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Active Setup"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Startup"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Footprints"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Export"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Dashboard"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
        <RadioButton Content="Settings"
                     Style="{StaticResource RadioButton.UnderlineTab}"
                     GroupName="AppMgmtMainNav"
                     Checked="MainNav_Checked" />
      </StackPanel>
      <RadioButton Content="Help"
                   Style="{StaticResource RadioButton.UnderlineTab}"
                   GroupName="AppMgmtMainNav"
                   HorizontalAlignment="Right"
                   Checked="MainNav_Checked" />
    </Grid>
    <shell:VestigiumShell x:Name="RootShell"
                          ShowNav="False"
                          Status="{Binding Status}"
                          StatusBarPosition="{Binding Status.Position, Mode=TwoWay}"
                          ShowStatusBar="{Binding ShowStatusBar}" />
  </DockPanel>
</Window>
