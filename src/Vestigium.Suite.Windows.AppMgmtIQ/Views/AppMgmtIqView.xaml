<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.AppMgmtIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:query="clr-namespace:Vestigium.Controls.QueryBar;assembly=Vestigium.Controls.QueryBar"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LeftCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,4,0" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Style>
    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Style>
    <Style x:Key="PackageRow" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Standard}">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackageCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Standard}">
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="0" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <query:VestigiumQueryBar Grid.Column="0" MinWidth="0"
                               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                               Session="{Binding Session}"
                               Queries="{Binding Queries}"
                               Limit="{Binding MruLimit}"
                               FilterRequested="OnFilter"
                               Committed="OnCommit"
                               PinRequested="OnPin" />
      <Button Grid.Column="1" Margin="8,0,0,0" Width="36" Height="36" Padding="0"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Button.Utility}"
              Command="{Binding RefreshCommand}" ToolTip="Refresh">
        <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="&#x267B;"
                   Foreground="#3DDC84"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </Grid>
    <!-- rest of the file remains the same; truncated for brevity in this call but full content would be used in real -->
  </Grid>
</UserControl>
