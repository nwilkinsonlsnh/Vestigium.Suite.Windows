<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.AppMgmtIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:query="clr-namespace:Vestigium.Controls.QueryBar;assembly=Vestigium.Controls.QueryBar"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LeftCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,4,0" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Style>
    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Style>
    <Style x:Key="PackageRow" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Standard}">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackageCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Standard}">
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="0" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <query:VestigiumQueryBar Grid.Column="0" MinWidth="0"
                               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                               Session="{Binding Session}"
                               Queries="{Binding Queries}"
                               Limit="{Binding MruLimit}"
                               FilterRequested="OnFilter"
                               Committed="OnCommit"
                               PinRequested="OnPin" />
      <Button Grid.Column="1" Margin="8,0,0,0" Width="36" Height="36" Padding="0"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Button.Utility}"
              Command="{Binding RefreshCommand}" ToolTip="Refresh">
        <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="&#x267B;"
                   Foreground="#3DDC84"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </Grid>
    <DataGrid Grid.Row="1"
              x:Name="PackageGrid"
              Style="{StaticResource DataGrid.Standard}"
              ItemsSource="{Binding Packages}"
              SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              ColumnWidth="*"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch"
              VerticalScrollBarVisibility="Visible"
              HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Visible"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              RowStyle="{StaticResource PackageRow}"
              CellStyle="{StaticResource PackageCell}"
              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
              MouseDoubleClick="Grid_MouseDoubleClick"
              SelectionChanged="Grid_SelectionChanged">
      <DataGrid.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#334C8DFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4F7FB" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334C8DFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F4F7FB" />
      </DataGrid.Resources>
      <DataGrid.ContextMenu>
        <ContextMenu Grid.IsSharedSizeScope="True"
                     Style="{StaticResource ContextMenu.Standard}"
                     Opened="Menu_Opened"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Open Details" Style="{StaticResource MenuItem.Standard}" Command="{Binding OpenDetailsCommand}" IsEnabled="{Binding HasSelection}">
            <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="UninstallItem" Header="Uninstall" Style="{StaticResource MenuItem.Standard}">
            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            <MenuItem x:Name="UninstallRegistered" Header="Product" Style="{StaticResource MenuItem.Standard}" Click="UninstallRegistered_Click" ToolTip="Run UninstallString exactly as stored.">
              <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="UninstallQuiet" Header="Forced (no interface)" Style="{StaticResource MenuItem.Standard}" Click="UninstallQuiet_Click" ToolTip="msiexec /x /qn. MSI only.">
              <MenuItem.Icon><TextBlock Text="&#xE7E8;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="UninstallBasic" Header="Forced (basic interface)" Style="{StaticResource MenuItem.Standard}" Click="UninstallBasic_Click" ToolTip="msiexec /x /qb. MSI only.">
              <MenuItem.Icon><TextBlock Text="&#xE7E8;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <MenuItem x:Name="ModifyItem" Header="Modify" Style="{StaticResource MenuItem.Standard}" Click="Modify_Click" ToolTip="Run ModifyPath after confirmation.">
            <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="RepairItem" Header="Repair" Style="{StaticResource MenuItem.Standard}" Click="Repair_Click" ToolTip="msiexec /fa when a product code is known.">
            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <MenuItem Header="Filter" Style="{StaticResource MenuItem.Standard}">
            <MenuItem.Icon><TextBlock Text="&#xE71C;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            <MenuItem x:Name="GlobalItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="Global packages" IsCheckable="True" IsChecked="{Binding DataContext.ShowGlobal, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="GlobalCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PerUserItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="Per-user packages" IsCheckable="True" IsChecked="{Binding DataContext.ShowPerUser, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="PerUserCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource Separator.MenuHost}" />
            <MenuItem x:Name="X64Item" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="x64" IsCheckable="True" IsChecked="{Binding DataContext.ShowX64, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="X64Check" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="X86Item" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="x86" IsCheckable="True" IsChecked="{Binding DataContext.ShowX86, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="X86Check" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource Separator.MenuHost}" />
            <MenuItem x:Name="SystemItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="System components" IsCheckable="True" IsChecked="{Binding DataContext.ShowSystemComponents, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="SystemCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource Separator.MenuHost}" />
            <MenuItem x:Name="InstallerItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="Windows Installer" IsCheckable="True" IsChecked="{Binding DataContext.ShowWindowsInstaller, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="InstallerCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="OtherItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Style="{StaticResource MenuItem.Standard}" Header="Other installers" IsCheckable="True" IsChecked="{Binding DataContext.ShowOtherInstallers, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="OtherCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <MenuItem Header="Export" Style="{StaticResource MenuItem.Standard}">
            <MenuItem.Icon><TextBlock Text="&#xE898;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            <MenuItem Style="{StaticResource MenuItem.Standard}" Header="Export grid\u2026" IsEnabled="False" ToolTip="Vestigium.Helpers.ClosedXml is not published yet.">
              <MenuItem.Icon><TextBlock Text="&#xE8A5;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource MenuItem.Standard}" Header="Export selected\u2026" IsEnabled="False" ToolTip="Vestigium.Helpers.ClosedXml is not published yet.">
              <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <MenuItem Header="Refresh" Style="{StaticResource MenuItem.Standard}" Command="{Binding Host.RefreshCommand}">
            <MenuItem.Icon><TextBlock FontFamily="Segoe UI Symbol" FontSize="14" Text="&#x267B;" Foreground="#3DDC84" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="36" MinWidth="36" CanUserResize="False" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:Name="NameColumn" Header="Display Name" Binding="{Binding DisplayName}" Width="2*" MinWidth="140" ElementStyle="{StaticResource LeftCell}" SortDirection="Ascending" />
        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" MinWidth="80" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion}" Width="*" MinWidth="70" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Install Date" Binding="{Binding DisplayInstallDate}" Width="*" MinWidth="90" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="*" MinWidth="70" ElementStyle="{StaticResource LeftCell}" />
        <DataGridCheckBoxColumn Header="x64" Binding="{Binding IsX64}" Width="*" MinWidth="46" />
        <DataGridCheckBoxColumn Header="Global" Binding="{Binding IsGlobal}" Width="*" MinWidth="56" />
        <DataGridCheckBoxColumn Header="SystemComponent" Binding="{Binding SystemComponent}" Width="*" MinWidth="90" />
        <DataGridCheckBoxColumn Header="WindowsInstaller" Binding="{Binding WindowsInstaller}" Width="*" MinWidth="90" />
        <DataGridCheckBoxColumn Header="NoModify" Binding="{Binding NoModify}" Width="*" MinWidth="70" />
        <DataGridCheckBoxColumn Header="NoRemove" Binding="{Binding NoRemove}" Width="*" MinWidth="70" />
        <DataGridCheckBoxColumn Header="NoRepair" Binding="{Binding NoRepair}" Width="*" MinWidth="70" />
        <DataGridTextColumn Header="Orphan" Binding="{Binding OrphanText}" Width="*" MinWidth="70" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Pending" Binding="{Binding PendingText}" Width="*" MinWidth="70" ElementStyle="{StaticResource LeftCell}" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
