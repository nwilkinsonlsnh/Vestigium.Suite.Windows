<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="AppMgmtIQ"
                   IsChecked="{Binding AppMgmtPageOpen}"
                   GroupName="SettingsPage" />
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="Themes"
                   IsChecked="{Binding ThemesPageOpen}"
                   GroupName="SettingsPage" />
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="MRUs"
                   IsChecked="{Binding MrusPageOpen}"
                   GroupName="SettingsPage" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="8,0,0,0"
                Visibility="{Binding AppMgmtPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Defaults for the inventory grid. Same checks as the Filter menu." />

      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Global packages" IsChecked="{Binding ShowGlobal}" Margin="0,0,0,8" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Per-user packages" IsChecked="{Binding ShowPerUser}" Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="x64" IsChecked="{Binding ShowX64}" Margin="0,0,0,8" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="x86" IsChecked="{Binding ShowX86}" Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="System components" IsChecked="{Binding ShowSystemComponents}" Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Windows Installer" IsChecked="{Binding ShowWindowsInstaller}" Margin="0,0,0,8" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Other installers" IsChecked="{Binding ShowOtherInstallers}" Margin="0,0,0,16" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Expand Windows features" IsChecked="{Binding FeaturesExpanded}" Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Date format" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding DateFormats}"
                DisplayMemberPath="Label"
                SelectedItem="{Binding SelectedDateFormat, Mode=TwoWay}"
                IsEditable="False"
                IsReadOnly="True"
                Width="220"
                HorizontalAlignment="Left"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Decimal places" />
      <nud:VestigiumNumericUpDown Value="{Binding DecimalPlaces, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="0"
                                  Maximum="8"
                                  Increment="1"
                                  PageIncrement="1"
                                  DecimalPlaces="0"
                                  Width="120"
                                  TextAlignment="Center"
                                  HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="8,0,0,0"
                Visibility="{Binding ThemesPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Palette for the application." />
      <Label Style="{StaticResource Label.Standard}" Content="Theme" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding Themes}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                IsEditable="False"
                IsReadOnly="True"
                Width="220"
                HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="480"
                Margin="8,0,0,0"
                Visibility="{Binding MrusPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Recent queries for each tab. Sticky entries stay at the top. Limit is the total. Sticky limit is the cap on pinned rows." />

      <Label Style="{StaticResource Label.Standard}" Content="MRU limit" />
      <nud:VestigiumNumericUpDown Value="{Binding MruLimit, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="0"
                                  Maximum="50"
                                  Increment="1"
                                  PageIncrement="1"
                                  DecimalPlaces="0"
                                  Width="120"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,12" />

      <Label Style="{StaticResource Label.Standard}" Content="Sticky limit" />
      <nud:VestigiumNumericUpDown Value="{Binding StickyLimit, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="0"
                                  Maximum="20"
                                  Increment="1"
                                  PageIncrement="1"
                                  DecimalPlaces="0"
                                  Width="120"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Tab" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding MruTabs}"
                SelectedItem="{Binding SelectedMruTab, Mode=TwoWay}"
                Width="220"
                HorizontalAlignment="Left"
                Margin="0,0,0,12" />

      <ListBox Style="{StaticResource ListBox.Standard}"
               ItemsSource="{Binding CurrentMrus}"
               SelectedItem="{Binding SelectedMru, Mode=TwoWay}"
               Height="220"
               Margin="0,0,0,8">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE841;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"
                         Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                         Visibility="{Binding IsSticky, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{Binding Text}"
                         Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox Style="{StaticResource TextBox.Standard}"
                 Text="{Binding NewMruText, UpdateSourceTrigger=PropertyChanged}"
                 Width="240"
                 Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}"
                Content="Add"
                Command="{Binding AddMruCommand}"
                Padding="12,4" />
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Secondary}"
                Content="Delete"
                Command="{Binding DeleteMruCommand}"
                Padding="12,4"
                Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}"
                Content="Up"
                Command="{Binding MoveMruUpCommand}"
                Padding="12,4"
                Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}"
                Content="Down"
                Command="{Binding MoveMruDownCommand}"
                Padding="12,4"
                Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}"
                Content="Sticky"
                Command="{Binding ToggleStickyCommand}"
                Padding="12,4" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
