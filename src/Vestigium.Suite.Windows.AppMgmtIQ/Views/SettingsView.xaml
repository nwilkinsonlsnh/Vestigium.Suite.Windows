<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="AppMgmtIQ"
                   IsChecked="{Binding AppMgmtPageOpen}"
                   GroupName="SettingsPage" />
      <RadioButton Style="{StaticResource RadioButton.UnderlineTab}"
                   Content="Themes"
                   IsChecked="{Binding ThemesPageOpen}"
                   GroupName="SettingsPage" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="8,0,0,0"
                Visibility="{Binding AppMgmtPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Defaults for the inventory grid." />

      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show Global Packages"
                IsChecked="{Binding ShowGlobal}"
                Margin="0,0,0,10" />
      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show Per User Packages"
                IsChecked="{Binding ShowPerUser}"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Date format" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding DateFormats}"
                DisplayMemberPath="Label"
                SelectedItem="{Binding SelectedDateFormat, Mode=TwoWay}"
                IsEditable="False"
                IsReadOnly="True"
                Width="220"
                HorizontalAlignment="Left"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Decimal places" />
      <nud:VestigiumNumericUpDown Value="{Binding DecimalPlaces, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="0"
                                  Maximum="8"
                                  Increment="1"
                                  PageIncrement="1"
                                  DecimalPlaces="0"
                                  Width="120"
                                  HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="8,0,0,0"
                Visibility="{Binding ThemesPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                 Text="Palette for the application." />
      <Label Style="{StaticResource Label.Standard}" Content="Theme" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding Themes}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                IsEditable="False"
                IsReadOnly="True"
                Width="220"
                HorizontalAlignment="Left" />
    </StackPanel>
  </DockPanel>
</UserControl>
