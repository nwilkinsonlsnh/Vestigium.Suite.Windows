<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <HierarchicalDataTemplate x:Key="FeatureTemplate" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid Margin="12">
    <TreeView x:Name="FeatureTree"
              ItemsSource="{Binding Roots}"
              ItemTemplate="{StaticResource FeatureTemplate}"
              Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
              SelectedItemChanged="Tree_SelectedItemChanged"
              MouseDoubleClick="Tree_MouseDoubleClick">
      <TreeView.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Open Details" Click="OpenDetails_Click" />
          <Separator />
          <MenuItem Header="Filter">
            <MenuItem Header="Enabled" IsCheckable="True" IsChecked="{Binding ShowEnabledFlag}" StaysOpenOnClick="True" />
            <MenuItem Header="Disabled" IsCheckable="True" IsChecked="{Binding ShowDisabledFlag}" StaysOpenOnClick="True" />
            <MenuItem Header="Absent" IsCheckable="True" IsChecked="{Binding ShowAbsentFlag}" StaysOpenOnClick="True" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>

    <Border Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
