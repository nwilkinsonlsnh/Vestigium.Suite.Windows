<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <HierarchicalDataTemplate x:Key="FeatureTemplate" ItemsSource="{Binding Children}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Caption}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
        <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      </Grid>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="20,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Style="{StaticResource TextBlock.Caption}" Text="Display Name" />
      <TextBlock Grid.Column="2" Style="{StaticResource TextBlock.Caption}" Text="Feature Name" />
      <TextBlock Grid.Column="3" Style="{StaticResource TextBlock.Caption}" Text="State" />
    </Grid>
    <TreeView Grid.Row="1"
              x:Name="FeatureTree"
              ItemsSource="{Binding Roots}"
              ItemTemplate="{StaticResource FeatureTemplate}"
              Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
              SelectedItemChanged="Tree_SelectedItemChanged"
              MouseDoubleClick="Tree_MouseDoubleClick">
      <TreeView.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Open Details" Click="OpenDetails_Click" />
          <Separator />
          <MenuItem Header="Filter">
            <MenuItem Header="Enabled" IsCheckable="True" IsChecked="{Binding ShowEnabledFlag}" StaysOpenOnClick="True" />
            <MenuItem Header="Disabled" IsCheckable="True" IsChecked="{Binding ShowDisabledFlag}" StaysOpenOnClick="True" />
            <MenuItem Header="Absent" IsCheckable="True" IsChecked="{Binding ShowAbsentFlag}" StaysOpenOnClick="True" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
