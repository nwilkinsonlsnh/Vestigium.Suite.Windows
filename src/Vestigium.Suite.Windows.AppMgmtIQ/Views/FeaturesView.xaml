<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FeatureItem" TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Raised}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <HierarchicalDataTemplate x:Key="FeatureTemplate" ItemsSource="{Binding Children}">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Caption}" VerticalAlignment="Center" Margin="4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
        <TextBlock Grid.Column="3" Text="{Binding Parent}" VerticalAlignment="Center" Margin="4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
        <TextBlock Grid.Column="4" Text="{Binding State}" VerticalAlignment="Center" Margin="4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
      </Grid>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="20,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Style="{StaticResource TextBlock.Caption}" Text="Display Name" />
      <TextBlock Grid.Column="2" Style="{StaticResource TextBlock.Caption}" Text="Feature Name" />
      <TextBlock Grid.Column="3" Style="{StaticResource TextBlock.Caption}" Text="Parent" />
      <TextBlock Grid.Column="4" Style="{StaticResource TextBlock.Caption}" Text="State" />
    </Grid>
    <TreeView Grid.Row="1"
              x:Name="FeatureTree"
              ItemsSource="{Binding Roots}"
              ItemTemplate="{StaticResource FeatureTemplate}"
              ItemContainerStyle="{StaticResource FeatureItem}"
              Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
              SelectedItemChanged="Tree_SelectedItemChanged"
              MouseDoubleClick="Tree_MouseDoubleClick">
      <TreeView.ContextMenu>
        <ContextMenu Opened="Menu_Opened">
          <MenuItem Header="Open Details" Click="OpenDetails_Click">
            <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem x:Name="ExpandItem" Header="Expand" Click="Expand_Click" IsEnabled="False">
            <MenuItem.Icon><TextBlock Text="&#xE70D;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="CollapseItem" Header="Collapse" Click="Collapse_Click" IsEnabled="False">
            <MenuItem.Icon><TextBlock Text="&#xE70E;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Filter">
            <MenuItem.Icon><TextBlock Text="&#xE71C;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            <MenuItem Header="Enabled" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowEnabledFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True" />
            <MenuItem Header="Disabled" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowDisabledFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True" />
            <MenuItem Header="Absent" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowAbsentFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Refresh" Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>

    <Border Grid.RowSpan="2"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
