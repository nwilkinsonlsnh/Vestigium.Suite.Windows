<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:query="clr-namespace:Vestigium.Controls.QueryBar;assembly=Vestigium.Controls.QueryBar"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="MenuIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FeatureItem" TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Standard}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <HierarchicalDataTemplate x:Key="FeatureTemplate" ItemsSource="{Binding Children}">
      <Grid Background="Transparent" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" SharedSizeGroup="FeatureCheck" />
          <ColumnDefinition Width="*" MinWidth="280" SharedSizeGroup="FeatureCaption" />
          <ColumnDefinition Width="180" SharedSizeGroup="FeatureName" />
          <ColumnDefinition Width="140" SharedSizeGroup="FeatureParent" />
          <ColumnDefinition Width="80" SharedSizeGroup="FeatureState" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Style="{StaticResource CheckBox.Standard}" IsThreeState="{Binding HasChildren}" IsChecked="{Binding CheckState, Mode=OneWay}" Click="Plan_Click" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
        <TextBlock Grid.Column="3" Text="{Binding Parent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
        <TextBlock Grid.Column="4" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      </Grid>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid Margin="12" IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="0" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <query:VestigiumQueryBar Grid.Column="0" MinWidth="0"
                               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                               Session="{Binding Session}"
                               Queries="{Binding Queries}"
                               Limit="{Binding MruLimit}"
                               FilterRequested="OnFilter"
                               Committed="OnCommit"
                               PinRequested="OnPin" />
      <Button Grid.Column="1" Margin="8,0,0,0" Width="36" Height="36" Padding="0"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Button.Utility}"
              Command="{Binding RefreshCommand}" ToolTip="Refresh">
        <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="&#x267B;"
                   Foreground="#3DDC84"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </Grid>
    <Grid Grid.Row="1" Margin="20,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" SharedSizeGroup="FeatureCheck" />
        <ColumnDefinition Width="*" MinWidth="280" SharedSizeGroup="FeatureCaption" />
        <ColumnDefinition Width="180" SharedSizeGroup="FeatureName" />
        <ColumnDefinition Width="140" SharedSizeGroup="FeatureParent" />
        <ColumnDefinition Width="80" SharedSizeGroup="FeatureState" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Style="{StaticResource TextBlock.Caption}" Text="Display Name" />
      <TextBlock Grid.Column="2" Style="{StaticResource TextBlock.Caption}" Text="Feature Name" />
      <TextBlock Grid.Column="3" Style="{StaticResource TextBlock.Caption}" Text="Parent" />
      <TextBlock Grid.Column="4" Style="{StaticResource TextBlock.Caption}" Text="State" />
    </Grid>
    <TreeView Grid.Row="2"
              x:Name="FeatureTree"
              Style="{StaticResource TreeView.Standard}"
              ItemsSource="{Binding Roots}"
              ItemTemplate="{StaticResource FeatureTemplate}"
              ItemContainerStyle="{StaticResource FeatureItem}"
              Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
              SelectedItemChanged="Tree_SelectedItemChanged"
              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
      <TreeView.ContextMenu>
        <ContextMenu Style="{StaticResource ContextMenu.Standard}" Grid.IsSharedSizeScope="True" Opened="Menu_Opened">
          <MenuItem x:Name="ExpandAllItem" Header="Expand All" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" Click="ExpandAll_Click">
            <MenuItem.Icon>
              <StackPanel>
                <TextBlock Text="&#xE70D;" Style="{StaticResource MenuIcon}" Margin="0,-6,0,-8" />
                <TextBlock Text="&#xE70D;" Style="{StaticResource MenuIcon}" Margin="0,-8,0,0" />
              </StackPanel>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ExpandItem" Header="Expand" Style="{StaticResource MenuItem.Standard}" Click="Expand_Click" IsEnabled="False">
            <MenuItem.Icon><TextBlock Text="&#xE70D;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="CollapseItem" Header="Collapse" Style="{StaticResource MenuItem.Standard}" Click="Collapse_Click" IsEnabled="False">
            <MenuItem.Icon><TextBlock Text="&#xE70E;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="CollapseAllItem" Header="Collapse All" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" Click="CollapseAll_Click">
            <MenuItem.Icon>
              <StackPanel>
                <TextBlock Text="&#xE70E;" Style="{StaticResource MenuIcon}" Margin="0,-6,0,-8" />
                <TextBlock Text="&#xE70E;" Style="{StaticResource MenuIcon}" Margin="0,-8,0,0" />
              </StackPanel>
            </MenuItem.Icon>
          </MenuItem>
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <MenuItem Header="Filter" Style="{StaticResource MenuItem.Standard}">
            <MenuItem.Icon><TextBlock Text="&#xE71C;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
            <MenuItem x:Name="EnabledItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Header="Enabled" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowEnabledFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="EnabledCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="DisabledItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Header="Disabled" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowDisabledFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="DisabledCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="AbsentItem" Checked="FilterCheck_Changed" Unchecked="FilterCheck_Changed" Header="Absent" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.ShowAbsentFlag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" StaysOpenOnClick="True">
              <MenuItem.Icon><TextBlock x:Name="AbsentCheck" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE739;" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <Separator Style="{StaticResource Separator.MenuHost}" />
          <MenuItem Header="Apply changes" Style="{StaticResource MenuItem.Standard}" Click="Apply_Click"
                    IsEnabled="{Binding PlacementTarget.DataContext.HasPlan, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Refresh" Style="{StaticResource MenuItem.Standard}" Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon><TextBlock FontFamily="Segoe UI Symbol" FontSize="14" Text="&#x267B;" Foreground="#3DDC84" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>

    <Border Grid.RowSpan="3"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
