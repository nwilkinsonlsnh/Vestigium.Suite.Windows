<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.ActiveSetupConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Active Setup Entry"
        Height="320" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Delete Entry" Width="140" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Click="Confirm_Click" />
      <Button Content="Cancel" Width="120" Style="{StaticResource Button.Secondary}" IsCancel="True" />
    </StackPanel>
    <StackPanel>
      <TextBlock Style="{StaticResource TextBlock.Heading}" Text="Delete Active Setup Entry" />
      <TextBlock x:Name="NameText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <TextBlock x:Name="PathText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
    </StackPanel>
  </DockPanel>
</Window>
