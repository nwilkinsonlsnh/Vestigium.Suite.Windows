<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="12,8,12,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Topics}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource RadioButton.VerticalNav}"
                         Content="{Binding Title}"
                         GroupName="AppMgmtHelpTopics"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         Margin="0,0,0,4"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Left" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <DockPanel Grid.Column="2">
      <ItemsControl x:Name="PageSections"
                    DockPanel.Dock="Top"
                    Visibility="Collapsed"
                    Margin="16,0,24,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource RadioButton.VerticalNav}"
                         Content="{Binding Title}"
                         GroupName="AppMgmtPageSections"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         Margin="0,0,8,0"
                         HorizontalContentAlignment="Left" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Margin="16,0,4,0"
              Padding="4,4,0,4"
              CornerRadius="8"
              Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
              BorderThickness="1">
        <FlowDocumentScrollViewer x:Name="Reader"
                                  VerticalScrollBarVisibility="Auto"
                                  IsToolBarVisible="False"
                                  Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                  Background="Transparent" />
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
