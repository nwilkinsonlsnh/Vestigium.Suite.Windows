<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.SnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Left">
    <TextBlock Style="{StaticResource TextBlock.Heading}" Text="Snapshot" Margin="0,0,0,16" />

    <WrapPanel Margin="0,0,0,12">
      <Button Style="{StaticResource Button.Secondary}" Content="Refresh" Click="Refresh_Click" Padding="14,4" Margin="0,0,8,8" />
      <Button Style="{StaticResource Button.Secondary}" Content="Delete" Click="Delete_Click" Padding="14,4" Margin="0,0,8,8" />
      <Button Style="{StaticResource Button.Primary}" Content="Capture" Click="Capture_Click" Padding="14,4" Margin="0,0,8,8" />
      <Button Style="{StaticResource Button.Secondary}" Content="Export" Click="Export_Click" Padding="14,4" Margin="0,0,8,8" />
      <Button Style="{StaticResource Button.Secondary}" Content="Import" Click="Import_Click" Padding="14,4" Margin="0,0,8,8" />
    </WrapPanel>

    <TextBlock x:Name="Story" Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,8" />
    <ComboBox x:Name="Snapshots" Style="{StaticResource ComboBox.Standard}" Width="320" Margin="0,0,0,16" HorizontalAlignment="Left" SelectionChanged="Snapshot_Changed" />

    <CheckBox x:Name="Packages" Style="{StaticResource CheckBox.ToggleSwitch}" Content="AppMgmtIQ" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
    <CheckBox x:Name="Features" Style="{StaticResource CheckBox.ToggleSwitch}" Content="Windows Features" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
    <CheckBox x:Name="BuiltIn" Style="{StaticResource CheckBox.ToggleSwitch}" Content="Built-In (Packages)" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
    <CheckBox x:Name="Setup" Style="{StaticResource CheckBox.ToggleSwitch}" Content="Active Setup" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
    <CheckBox x:Name="Startup" Style="{StaticResource CheckBox.ToggleSwitch}" Content="Startup" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
    <CheckBox x:Name="Footprints" Style="{StaticResource CheckBox.ToggleSwitch}" Content="Footprints" Margin="0,0,0,8" Checked="Choice_Changed" Unchecked="Choice_Changed" />
  </StackPanel>
</UserControl>
