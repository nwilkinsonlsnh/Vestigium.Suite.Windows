<UserControl x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LeftCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,4,0" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Style>
    <Style x:Key="StartupRow" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Standard}">
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Softer}" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StartupCell" TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Standard}">
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Details" TargetType="Border">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
      <Button Width="36" Height="36" Padding="0"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource Button.Utility}"
              Command="{Binding RefreshCommand}" ToolTip="Refresh">
        <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="&#x267B;"
                   Foreground="#3DDC84"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </StackPanel>
    <DataGrid Grid.Row="1"
              Style="{StaticResource DataGrid.Standard}"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowStyle="{StaticResource StartupRow}"
              CellStyle="{StaticResource StartupCell}"
              Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
              Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}">
      <DataGrid.ContextMenu>
        <ContextMenu Style="{StaticResource ContextMenu.Standard}">
          <MenuItem Header="Refresh" Style="{StaticResource MenuItem.Standard}" Command="{Binding RefreshCommand}">
            <MenuItem.Icon><TextBlock FontFamily="Segoe UI Symbol" FontSize="14" Text="&#x267B;" Foreground="#3DDC84" /></MenuItem.Icon>
          </MenuItem>
          <Separator Style="{StaticResource Separator.Standard}" />
          <MenuItem Header="Copy" Style="{StaticResource MenuItem.Standard}">
            <MenuItem Header="Name" Style="{StaticResource MenuItem.Standard}" Command="{Binding CopyNameCommand}" />
            <MenuItem Header="Command" Style="{StaticResource MenuItem.Standard}" Command="{Binding CopyCommandCommand}" />
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="60" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="200" ElementStyle="{StaticResource LeftCell}" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Margin="0,8,0,0" Padding="12"
            Style="{StaticResource Details}"
            BorderBrush="{DynamicResource Vestigium.Brushes.Border.Subtle}"
            BorderThickness="1"
            Background="{DynamicResource Vestigium.Brushes.Surface.Panel}">
      <StackPanel>
        <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap">
          <Run Text="{Binding Selected.Name, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text="  ·  " />
          <Run Text="{Binding Selected.Source, Mode=OneWay}" />
          <Run Text="  ·  " />
          <Run Text="{Binding Selected.Scope, Mode=OneWay}" />
          <Run Text="  ·  " />
          <Run Text="{Binding Selected.Bit, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource TextBlock.Caption}"
                   Text="{Binding Selected.Command, Mode=OneWay}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource TextBlock.Caption}"
                   Text="{Binding Selected.Package, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Grid.RowSpan="3"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource TextBlock.Caption}" HorizontalAlignment="Center" Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
