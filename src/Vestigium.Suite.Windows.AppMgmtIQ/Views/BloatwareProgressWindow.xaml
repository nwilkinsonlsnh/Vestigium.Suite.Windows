<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.Views.BloatwareProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Built-In Package"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CopyButton" Content="Copy" Width="120" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Click="Copy_Click" Visibility="Collapsed" />
      <Button x:Name="CloseButton" Content="Close" Width="120" Style="{StaticResource Button.Primary}" IsCancel="True" Visibility="Collapsed" />
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource TextBlock.Heading}" />
      <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <ProgressBar x:Name="Bar" Margin="0,16,0,0" Height="6" IsIndeterminate="True" />
      <TextBlock x:Name="NameText" Margin="0,12,0,0" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
      <TextBox x:Name="DetailBox" Margin="0,12,0,0" Height="160" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.ReadOnly}" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
