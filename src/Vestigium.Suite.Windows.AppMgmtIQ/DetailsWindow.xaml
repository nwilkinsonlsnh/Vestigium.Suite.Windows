<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="560" Width="860"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Window.Resources>
    <Style x:Key="LeftCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,4,0" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <ItemsControl x:Name="TabStrip" DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Content="{Binding Header}"
                       Style="{StaticResource RadioButton.UnderlineTab}"
                       GroupName="DetailsTabs"
                       Checked="Tab_Checked" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DataGrid Style="{StaticResource DataGrid.Standard}"
              ItemsSource="{Binding SelectedTab.Rows}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              ColumnWidth="*"
              HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Visible">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" MinWidth="120" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="88" MinWidth="72" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*" MinWidth="240" ElementStyle="{StaticResource LeftCell}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
