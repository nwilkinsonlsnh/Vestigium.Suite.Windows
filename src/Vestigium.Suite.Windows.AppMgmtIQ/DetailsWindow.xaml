<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="560" Width="860"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Window.Resources>
    <Style x:Key="LeftCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,4,0" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <ItemsControl x:Name="TabStrip" DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Content="{Binding Header}"
                       Style="{StaticResource RadioButton.UnderlineTab}"
                       GroupName="DetailsTabs"
                       Checked="Tab_Checked" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DataGrid x:Name="ValueGrid"
              Style="{StaticResource DataGrid.Standard}"
              ItemsSource="{Binding SelectedTab.Rows}"
              SelectionMode="Extended"
              SelectionUnit="Cell"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              CanUserSortColumns="False"
              PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
              ColumnWidth="*"
              HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Visible"
              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
      <DataGrid.ContextMenu>
        <ContextMenu Style="{StaticResource ContextMenu.Standard}" Opened="Menu_Opened" Grid.IsSharedSizeScope="True">
          <MenuItem Header="Refresh" Style="{StaticResource MenuItem.Standard}" Click="Refresh_Click">
            <MenuItem.Icon><TextBlock FontFamily="Segoe UI Symbol" FontSize="14" Text="&#x267B;" Foreground="#3DDC84" /></MenuItem.Icon>
          </MenuItem>
          <Separator Style="{StaticResource Separator.Menu}" />
          <MenuItem x:Name="CopyItem" Header="Copy" Style="{StaticResource MenuItem.Standard}">
            <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8C8;" /></MenuItem.Icon>
            <MenuItem x:Name="CopyDataItem" Header="Value Data" Style="{StaticResource MenuItem.Standard}" Click="CopyData_Click" />
            <Separator Style="{StaticResource Separator.Menu}" />
            <MenuItem Header="Value Information" Style="{StaticResource MenuItem.Standard}" Click="CopyInfo_Click" />
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" MinWidth="120" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="88" MinWidth="72" ElementStyle="{StaticResource LeftCell}" />
        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*" MinWidth="240" ElementStyle="{StaticResource LeftCell}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
