<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.FeaturePlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Feature Changes"
        Height="640" Width="760"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
        Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock x:Name="ElevationNote" VerticalAlignment="Center" Margin="0,0,12,0"
                 Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
      <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Padding="16,4" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource Button.Primary}" Padding="16,4" IsDefault="True" Click="Confirm_Click" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"
               Text="Nothing is changed until you confirm. Parents required by a checked feature, and children of a cleared feature, are already in these lists." />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="Enable" Margin="0,0,0,6" />
        <ListBox x:Name="EnableList" Style="{StaticResource ListBox.Standard}" />
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="Disable" Margin="0,0,0,6" />
        <ListBox x:Name="DisableList" Style="{StaticResource ListBox.Standard}" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
