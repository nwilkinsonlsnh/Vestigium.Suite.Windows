<Window x:Class="Vestigium.Suite.Windows.AppMgmtIQ.ActiveSetup.ApplyActiveSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Active Setup Changes"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ContinueButton" Content="Continue" Width="120" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" Click="Continue_Click" />
      <Button x:Name="CloseButton" Content="Close" Width="120" Style="{StaticResource Button.Secondary}" Click="Close_Click" />
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource TextBlock.Heading}" Text="Apply Active Setup Changes" />
      <TextBlock x:Name="Summary" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <TextBlock x:Name="PathText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
      <TextBlock x:Name="CommandText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
      <TextBlock x:Name="Outcome" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
