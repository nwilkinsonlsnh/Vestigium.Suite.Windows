<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <Copyright>Copyright (c) 2026 Nathaniel Wilkinson</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <VestigiumLoggingVersion>2.0.0</VestigiumLoggingVersion>
    <VestigiumThemesVersion>1.1.0</VestigiumThemesVersion>
    <VestigiumControlsVersion>1.0.0</VestigiumControlsVersion>
    <VestigiumStatusBarVersion>1.0.1</VestigiumStatusBarVersion>
    <VestigiumNumericUpDownVersion>1.0.2</VestigiumNumericUpDownVersion>
    <VestigiumUnderConstructionVersion>1.0.1</VestigiumUnderConstructionVersion>
    <VestigiumConvertersVersion>1.0.0</VestigiumConvertersVersion>
    <VestigiumWinRegVersion>1.0.0</VestigiumWinRegVersion>
    <VestigiumFileSystemPathsVersion>1.4.0</VestigiumFileSystemPathsVersion>
    <VestigiumSystemInfoVersion>1.4.0</VestigiumSystemInfoVersion>
    <VestigiumKqlVersion>3.4.1</VestigiumKqlVersion>
    <VestigiumKqlAppMgmtVersion>1.5.0</VestigiumKqlAppMgmtVersion>
    <VestigiumKqlActiveSetupVersion>1.0.0</VestigiumKqlActiveSetupVersion>
    <VestigiumQueryBarVersion>1.3.0</VestigiumQueryBarVersion>
    <VestigiumClosedXmlVersion>1.0.1</VestigiumClosedXmlVersion>
    <VestigiumAnalyticsVersion>1.0.4</VestigiumAnalyticsVersion>
    <VestigiumChartsVersion>1.0.11</VestigiumChartsVersion>
    <VestigiumFileIoVersion>1.2.2</VestigiumFileIoVersion>
    <VestigiumHashingVersion>1.4.1</VestigiumHashingVersion>
    <MicrosoftExtensionsDiVersion>10.0.12</MicrosoftExtensionsDiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Vestigium.Suite.Windows.Documentation'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Vestigium.Suite.Windows.Documentation'">
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Vestigium.Suite.Windows.Documentation'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="LICENSE" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Link="README.md" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
